# Copy to backend/.env and fill in. Real values never belong in git.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
FRONTEND_URL=http://localhost:5173
# Comma-separated origins accepted in a session token's `azp` claim.
# Leave blank to allow only FRONTEND_URL.
AUTHORIZED_PARTIES=
FREE_GENERATION_LIMIT=1
DAILY_GENERATION_LIMIT=10
# Abuse ceiling: generations started per Europe/London day, on every plan.
# Counted when a slot is reserved, before any work starts, and never refunded,
# so a loop of generate-then-disconnect cannot run for free. A refused request
# reserves nothing and costs nothing. Sits above DAILY_GENERATION_LIMIT so a
# paying customer never meets it.
MAX_DAILY_ATTEMPTS=20
# Abuse ceiling for /api/render-pdf, per Europe/London day, on every plan.
# Rendering reserves no generation slot — re-downloading a paper is free — but
# every call launches a headless Chromium, so this is the only thing bounding
# the most expensive endpoint. Counted before the browser starts and never
# refunded. 50 is far above a day of real re-downloading.
MAX_DAILY_RENDERS=50
# Wall-clock seconds one PDF render may take before it is killed and the
# request answered 504. The HTML and CSS come off the wire and Chromium's own
# print call has no timeout, so without this a single document can pin a
# worker forever.
RENDER_TIMEOUT_SECONDS=20
# Renders allowed to run at the same time, across all users. Each one is a
# Chromium holding a few hundred megabytes, so a burst that fits inside every
# other limit can still be an out-of-memory kill. In-process state: correct
# only while the API runs a SINGLE uvicorn worker (see the deploy checklist).
MAX_CONCURRENT_RENDERS=2
# How long a request waits for one of those slots before answering 503. The
# render it had counted is given back, since nothing was launched.
RENDER_SLOT_WAIT_SECONDS=10
DATABASE_URL=
# Throwaway Postgres for tests/test_db.py, which CREATES AND DROPS tables.
# Deliberately separate from DATABASE_URL so a test run can never wipe your
# development data. Leave blank to skip those tests.
TEST_DATABASE_URL=
