# Copy to backend/.env and fill in. Real values never belong in git.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
FRONTEND_URL=http://localhost:5173
# Comma-separated origins accepted in a session token's `azp` claim.
# Leave blank to allow only FRONTEND_URL.
AUTHORIZED_PARTIES=
FREE_GENERATION_LIMIT=1
DAILY_GENERATION_LIMIT=10
# Abuse ceiling: generations started per Europe/London day, on every plan.
# Counted when a slot is reserved, before any work starts, and never refunded,
# so a loop of generate-then-disconnect cannot run for free. A refused request
# reserves nothing and costs nothing. Sits above DAILY_GENERATION_LIMIT so a
# paying customer never meets it.
MAX_DAILY_ATTEMPTS=20
DATABASE_URL=
# Throwaway Postgres for tests/test_db.py, which CREATES AND DROPS tables.
# Deliberately separate from DATABASE_URL so a test run can never wipe your
# development data. Leave blank to skip those tests.
TEST_DATABASE_URL=
